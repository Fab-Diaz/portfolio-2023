    "test": "jest",
    "prettier": "prettier \"**/*.+(json|yml|yaml|css|ts|tsx|md|mdx)\"",
    "format": "prettier \"**/*.+(json|yml|yaml|css|ts|tsx|md|mdx)\" --write",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "eslint --ext .ts,.tsx ./src --fix"
  },
  "dependencies": {
