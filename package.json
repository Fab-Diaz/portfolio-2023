    "jsdom": "^20.0.3",
    "lint-staged": "^11.2.6",
    "prettier": "^3.7.4",
    "ts-jest": "^28.0.8",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^3.5.2",
    "typescript": "^5.6.3"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "transform": {
    "\\.js$": "<rootDir>/node_modules/babel-jest"
  }
