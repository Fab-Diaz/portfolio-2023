    "react-type-animation": "^2.1.2",
    "storybook": "^6.5.16",
    "styled-system": "^5.1.5",
    "swiper": "^8.4.7",
    "three": "^0.146.0",
    "typescript-eslint": "^^0.0.1-alpha.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^13.2.1",
