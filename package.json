    "@types/react-lazy-load-image-component": "^1.6.5",
    "@types/styled-system": "^5.1.25",
    "@types/styled-system__css": "^5.0.22",
    "@types/three": "^0.146.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "babel-jest": "^27.5.1",
