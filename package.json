    "@mui/styled-engine-sc": "^6.2.0",
    "@mui/styles": "^6.3.0",
    "@react-three/drei": "9.88.13",
    "@react-three/fiber": "^8.15.19",
    "@testing-library/react-hooks": "^7.0.2",
    "@testing-library/user-event": "^14.6.1",
